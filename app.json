{
  "expo": {
    "name": "Tserohr",
    "slug": "tserohr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tserohr",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF9F5",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E5A46"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tserohr.merge"
    },
    "android": {
      "package": "app.tserohr.merge",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/icon-monochrome.png",
        "backgroundColor": "#2E5A46"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "38b74cdc-55ab-458e-b5e3-a94eb5288f76"
      }
    },
    "owner": "ykolo"
  }
}
