// Comptes et synchronisation de Confluent.
//
// Les sauvegardes et les fusions elles-mêmes vivent dans R2 (`objectKey`) :
// la base ne garde que leurs métadonnées. Les clés commencent par le type
// d'objet (`backups/{userId}/…`, `merges/{userId}/…`), pour que la règle de
// cycle de vie du bucket, dont le préfixe est littéral, puisse les viser.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Prisma refuse le tiret dans une valeur d'enum : `keep_both` ici,
// `'keep-both'` dans le moteur (`src/merge.ts`). Les DTO font la conversion.
enum Strategy {
  keep_both
  newest
}

enum Slot {
  a
  b
}

// `pending` tant que l'envoi vers R2 n'est pas confirmé, `ready` ensuite.
enum Status {
  pending
  ready
}

model Backup {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Emplacement A ou B. Remis à null quand une autre sauvegarde prend la place
  // ou qu'une fusion la consomme : l'unicité (userId, slot) ne porte alors
  // plus dessus. Toujours null tant que l'envoi n'est pas confirmé.
  slot            Slot?
  objectKey       String   @unique
  // Taille et empreinte annoncées à la création du ticket d'envoi.
  size            Int
  sha256          String
  // Renseignés à la confirmation (`POST /api/backups/:id/confirm`) : null tant
  // que la ligne est `pending`, toujours présents une fois `ready`.
  name            String?
  deviceName      String?
  backupCreatedAt DateTime?
  counts          Json?
  uploadedFrom    String?
  status          Status   @default(pending)
  createdAt       DateTime @default(now())

  @@unique([userId, slot])
  @@map("backup")
}

model Merge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectKey String    @unique
  size      Int
  sha256    String
  // Renseignés à la confirmation (`POST /api/merges/:id/confirm`) : null tant
  // que la ligne est `pending`, toujours présents une fois `ready`.
  fileName  String?
  sources   String?
  strategy  Strategy?
  report    Json?
  status    Status    @default(pending)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("merge")
}

// --- Better Auth -------------------------------------------------------------
// Les tables de Better Auth 1.7, conformes à ses définitions (`getAuthTables`
// de `better-auth/db`, vérifié pour YKO-41) : le noyau, plus `rateLimit` parce
// que la limitation de débit est stockée en base (voir `lib/auth.ts`). Le
// plugin `expo()` n'ajoute pas de table.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  backups       Backup[]
  merges        Merge[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  // Horodatage en millisecondes : il dépasse la capacité d'un Int.
  lastRequest BigInt

  @@map("rateLimit")
}
