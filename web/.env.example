# Copier en .env.local et remplir. Aucune valeur réelle ici.

# Neon : URL poolée (hôte en -pooler) pour l'app, URL directe pour prisma migrate.
# En local : branche "dev". En production : branche "main".
DATABASE_URL=
DIRECT_URL=

# Better Auth : secret généré (openssl rand -base64 32) et URL publique du site.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 : jeton limité au bucket confluent-backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=confluent-backups

# Cron Vercel : secret envoyé en en-tête Authorization par le ménage quotidien
# (openssl rand -base64 32). À définir en Production.
CRON_SECRET=
